# ============================================================================
# Variables de entorno de la API - Academia Gimenoos
# Copiar a `.env` y completar. El archivo `.env` NUNCA se commitea.
# ============================================================================

NODE_ENV=development
PORT=3000

# --- Base de datos ---------------------------------------------------------
# DATABASE_URL: la usa la aplicacion en runtime.
#   Supabase -> Project Settings > Database > Connection string > Transaction pooler
#   Host: aws-0-<region>.pooler.supabase.com  Puerto: 6543  + ?pgbouncer=true
#   Desde el 28/02/2025 el puerto 6543 soporta unicamente Transaction Mode.
# DIRECT_URL: la usa SOLO `prisma migrate` (necesita una conexion sin pooling).
#   Supabase -> Connection string > Direct connection. Puerto: 5432
#
# Valores para el Postgres local de docker-compose (pnpm db:up):
DATABASE_URL="postgresql://gimenoos:gimenoos_dev@localhost:5433/gimenoos?schema=public"
DIRECT_URL="postgresql://gimenoos:gimenoos_dev@localhost:5433/gimenoos?schema=public"
#
# Ejemplo con Supabase (reemplazar <PROJECT_REF> y <PASSWORD>). El host real,
# con su region, se copia del panel: Project Settings > Database.
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase --------------------------------------------------------------
# Project Settings > API
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# Clave service_role: saltea RLS. SOLO en el backend, jamas en un frontend.
# Si se filtra, rotarla inmediatamente desde el panel de Supabase.
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"
# Solo si el proyecto aun usa el secreto JWT heredado (HS256).
# Recomendado: migrar a claves asimetricas (ES256) y dejar esta variable vacia.
SUPABASE_JWT_LEGACY_SECRET=""

# --- Puerta de arranque ----------------------------------------------------
# La unica direccion que puede entrar SIN invitacion, y lo hace como ADMIN.
# Hace falta dos veces: en la primera instalacion, y si se rehace el proyecto de
# Supabase (ahi cambian todos los identificadores de cuenta).
# Vaciala despues del primer ingreso: mientras este puesta, quien controle esa
# casilla de correo puede crearse un administrador.
ADMIN_INICIAL_EMAIL=""

# --- Direcciones de los frontends ------------------------------------------
# A donde cae cada persona al tocar el enlace de su invitacion.
APP_ALUMNO_URL="http://localhost:5175"
APP_PANEL_URL="http://localhost:5174"
APP_INSTRUCTOR_URL="http://localhost:5176"

# --- Seguridad HTTP --------------------------------------------------------
# Origenes permitidos para CORS, separados por coma. Sin comodines.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"
THROTTLE_TTL_SEGUNDOS=60
THROTTLE_LIMITE=100

# --- Avisos por Telegram ----------------------------------------------------
# Token del bot, tal como lo entrega @BotFather. Es una credencial: quien lo
# tenga puede escribir como el bot. Va SOLO acá, nunca en la base de datos ni en
# ninguna pantalla del panel.
# Dejalo vacio si todavia no creaste el bot: la API arranca igual y no manda
# avisos. El resto —a que conversacion se escribe y que se avisa— se configura
# desde el panel, en Avisos. Ver docs/23-avisos-telegram.md.
TELEGRAM_BOT_TOKEN=""

# Secreto que tiene que presentar quien dispara los recordatorios de clase.
# Los recordatorios NO los lanza un temporizador interno: en el plan gratuito de
# Render el servicio se duerme, y dormido no dispararia nada. Los dispara una
# llamada de afuera (hoy, un workflow de GitHub Actions cada 15 minutos).
# Generalo con: openssl rand -base64 48
# Vacio o sin poner, el endpoint contesta 503 y NUNCA queda abierto.
# Ver docs/24-recordatorios.md.
RECORDATORIOS_TOKEN=""

# --- Avisos en el telefono del alumno (Web Push) ----------------------------
# Par de claves VAPID con el que la API firma cada aviso. Se generan UNA vez:
#
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
#
# La publica se sirve desde GET /push/clave-publica (es publica de verdad, viaja
# en cada suscripcion). La privada es una credencial y vive solo aca.
#
# OJO: cambiarlas invalida TODAS las suscripciones y cada alumno tendria que
# volver a dar permiso. Se generan una vez y no se tocan.
# Vacias = no se mandan avisos al telefono, y la app lo dice en vez de fallar.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto de quien manda los avisos, como pide el estandar.
VAPID_SUBJECT="mailto:contacto@academiagimenoos.com.uy"

# --- Correo que manda la API por su cuenta ----------------------------------
# Los correos de INVITACION y de INGRESO los manda Supabase Auth, que solo sabe
# mandar los suyos. Un recordatorio de clase no es ninguno de esos, asi que sale
# desde aca, contra el MISMO servidor que ya configuraste en Supabase (Brevo).
# Que sea el mismo importa: el dominio ya esta autenticado ahi y estos correos
# heredan esa reputacion.
#
# La clave SMTP es la MISMA que pusiste en Supabase. Es una credencial: va del
# panel de Brevo a Render, sin pasar por ningun chat.
# Vacio = la API arranca igual y no manda correos.
# Ver docs/28-recordatorio-por-correo.md.
SMTP_HOST=""
SMTP_PUERTO=587
SMTP_USER=""
SMTP_PASSWORD=""
# Con nombre, entre comillas: Academia Gimenoos <avisos@tudominio.com>
SMTP_DESDE="Academia Gimenoos <no-responder@academiagimenoos.com.uy>"
