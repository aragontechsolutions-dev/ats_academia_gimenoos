// ============================================================================
// Esquema de datos - Academia de Choferes Gimenoos
// Postgres (Supabase) + Prisma v5
//
// Convenciones:
//  - Modelos en PascalCase, tablas y columnas en snake_case via @map / @@map.
//  - Todas las fechas/horas se guardan en UTC con tipo timestamptz.
//    Esto NO es cosmetico: la EXCLUDE constraint anti-doble-reserva usa
//    tstzrange(), que requiere timestamptz. Con el `timestamp` por defecto
//    de Prisma la constraint no funciona correctamente.
//  - Los importes son Decimal(12,2) en pesos uruguayos (UYU).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooler de Supabase (Supavisor, puerto 6543, transaction mode) + ?pgbouncer=true
  url       = env("DATABASE_URL")
  // Conexion directa (puerto 5432). Requerida por `prisma migrate`, que necesita
  // una conexion unica sin pooling.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums (deben coincidir con packages/shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum RolUsuario {
  ADMIN
  INSTRUCTOR
  CLIENTE
}

/// Estado de una invitacion a usar el sistema.
enum EstadoInvitacion {
  /// Emitida y todavia sin usar.
  PENDIENTE
  /// La persona entro y su cuenta quedo creada y vinculada.
  ACEPTADA
  /// La academia la dio de baja antes de que se usara.
  REVOCADA
}

/// Por donde se le hizo llegar el acceso a la persona.
enum CanalInvitacion {
  /// Supabase manda el correo con el enlace.
  CORREO
  /// Se genera el enlace y la academia lo manda por su cuenta, tipicamente
  /// pegandolo en la conversacion de WhatsApp que ya esta teniendo.
  ENLACE
}

enum TipoVehiculo {
  MOTO
  AUTO
}

enum CategoriaLicencia {
  A
  G1
  G2
  G3
}

/// Con que documento se identifica un alumno.
enum TipoIdentificacion {
  /// Cedula de identidad uruguaya.
  CEDULA
  /// Pasaporte, para alumnos extranjeros.
  PASAPORTE
}

enum EstadoVehiculo {
  ACTIVO
  MANTENIMIENTO
  BAJA
}

enum TipoServicio {
  CLASE_SUELTA
  PACK
  CURSO_COMPLETO
  GESTORIA
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  COMPLETADA
  CANCELADA
  AUSENTE
}

enum TipoExcepcion {
  BLOQUEO
  DISPONIBILIDAD_EXTRA
}

enum CanalPago {
  MP_ONLINE
  MP_POINT
  TRANSFERENCIA
  EFECTIVO
}

enum EstadoPago {
  PENDIENTE
  PENDIENTE_VERIFICACION
  APROBADO
  RECHAZADO
  REEMBOLSADO
}

enum EstadoExpediente {
  INICIADO
  DOCS_PENDIENTES
  MEDICO_OK
  CHARLA_OK
  TEORICO_APROBADO
  PRACTICO_APROBADO
  EMITIDA
  RECHAZADO
}

enum TipoDocumento {
  CEDULA
  CONSTANCIA_DOMICILIO
  CARNE_SALUD
  SOA
  FOTO
  AUTORIZACION_MENOR
  LIBRE_MULTAS
  OTRO
}

// ---------------------------------------------------------------------------
// Identidad y perfiles
// ---------------------------------------------------------------------------

/// Espejo local del usuario de Supabase Auth.
/// `id` es el mismo UUID que `auth.users.id` (claim `sub` del JWT): no se genera aca.
/// La contrasenia y los factores de autenticacion viven SOLO en Supabase Auth.
model Usuario {
  id       String     @id @db.Uuid
  email    String     @unique
  nombre   String
  apellido String
  telefono String?
  rol      RolUsuario @default(CLIENTE)
  activo   Boolean    @default(true)

  /// Fecha en que el usuario presto consentimiento informado para el tratamiento
  /// de sus datos personales (Ley 18.331). Null = consentimiento no registrado.
  consentimientoDatosAt DateTime? @map("consentimiento_datos_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cliente           Cliente?
  instructor        Instructor?
  suscripcionesPush SuscripcionPush[]
  auditorias        RegistroAuditoria[]

  @@index([rol])
  @@map("usuarios")
}

/// Invitacion a usar el sistema.
///
/// Es la UNICA puerta de entrada: sin una invitacion vigente, un token valido de
/// Supabase no alcanza para que la API aprovisione la cuenta. Antes el acceso se
/// resolvia adivinando por correo despues del hecho, lo que dejaba entrar a
/// cualquiera y creaba fichas de alumno vacias.
///
/// Guarda A QUE FICHA pertenece (`clienteId` o `instructorId`), asi el vinculo
/// queda dicho de antemano en vez de deducirse, y funciona aunque haya dos
/// fichas con el mismo correo o el alumno no tenga correo cargado.
model Invitacion {
  id String @id @default(uuid()) @db.Uuid

  /// Siempre en minuscula: Supabase normaliza los correos y la comparacion
  /// tiene que dar igual escriba como escriba quien la carga.
  email  String
  /// Con que rol se crea la cuenta. No se lee del token: `app_metadata` vive en
  /// Supabase y esto vive en la base de la aplicacion, que es la fuente de verdad.
  rol    RolUsuario       @default(CLIENTE)
  estado EstadoInvitacion @default(PENDIENTE)

  /// A quien pertenece. Como mucho uno de los dos; una invitacion de ADMIN no
  /// tiene ninguno.
  clienteId    String? @map("cliente_id") @db.Uuid
  instructorId String? @map("instructor_id") @db.Uuid

  /// Cuando se entrego el acceso. Null = la fila existe pero no salio por ningun
  /// lado todavia, y hay que reintentar.
  enviadaAt   DateTime?        @map("enviada_at") @db.Timestamptz(3)
  /// Por donde se entrego. Null mientras no se haya entregado.
  ///
  /// El enlace EN SI no se guarda nunca, ni aca ni en los registros: es una
  /// credencial, y quien la tenga entra como esa persona. Se genera, se usa y se
  /// olvida.
  canal       CanalInvitacion?
  aceptadaAt  DateTime?        @map("aceptada_at") @db.Timestamptz(3)
  /// Usuario que se creo al aceptarla.
  aceptadaPor String?          @map("aceptada_por") @db.Uuid

  invitadaPor String?  @map("invitada_por") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cliente    Cliente?    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  instructor Instructor? @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  /// El ingreso busca por correo y estado en cada primer acceso.
  @@index([email, estado])
  @@index([clienteId])
  @@index([instructorId])
  @@map("invitaciones")
}

/// Ficha del alumno. Contiene datos identificatorios (cedula) que son datos
/// personales bajo Ley 18.331: el acceso esta restringido por rol en la API.
///
/// El alumno existe con independencia de que tenga cuenta para entrar al
/// sistema: la mayoria se anota en el local y nunca inicia sesion. Por eso los
/// datos de contacto viven aca y `usuarioId` es opcional.
///
/// Division de responsabilidades: Cliente es el alumno (entidad del negocio),
/// Usuario es la credencial de acceso. Cuando el alumno se crea una cuenta, se
/// vinculan por correo (ver UsuariosService.resolverDesdeToken).
model Cliente {
  id        String  @id @default(uuid()) @db.Uuid
  usuarioId String? @unique @map("usuario_id") @db.Uuid

  nombre   String
  apellido String
  telefono String?
  /// Sirve ademas para vincular la ficha con la cuenta cuando el alumno se registra.
  email    String?

  /// Con que documento se identifica. Un alumno extranjero puede sacar la
  /// libreta con su pasaporte.
  tipoDocumento   TipoIdentificacion @default(CEDULA) @map("tipo_documento")
  /// Pais emisor, ISO 3166-1 alfa-2. Para la cedula uruguaya es siempre UY.
  paisDocumento   String             @default("UY") @map("pais_documento") @db.Char(2)
  /// Numero del documento. La cedula va solo con digitos, incluido el
  /// verificador; el pasaporte puede llevar letras y se guarda en mayusculas.
  documento       String?
  fechaNacimiento DateTime?          @map("fecha_nacimiento") @db.Date
  direccion       String?
  ciudad          String             @default("San Carlos")
  /// Observaciones internas del instructor/admin. No visible para el cliente.
  notasInternas   String?            @map("notas_internas")
  activo          Boolean            @default(true)

  /// Si quiere recibir los recordatorios de clase por correo.
  ///
  /// Arranca en true: quien deja su correo para que la academia le escriba
  /// espera que le escriba. Se apaga desde su perfil o desde el enlace de baja
  /// que lleva cada correo.
  recibeAvisosPorCorreo Boolean @default(true) @map("recibe_avisos_por_correo")

  /// Lo que hace posible darse de baja SIN iniciar sesion.
  ///
  /// Viaja en el enlace de cada correo. Es un UUID y no una firma calculada
  /// porque asi no hace falta un secreto mas en el servidor, y porque se puede
  /// invalidar de a uno: cambiarlo corta los enlaces viejos de ESA persona sin
  /// tocar los de nadie mas.
  ///
  /// Quien lo tenga puede darse de baja de los correos de esa persona, y nada
  /// mas: no da acceso a ningun dato ni a ninguna otra accion.
  ///
  /// El valor por defecto lo pone POSTGRES y no Prisma. Con el de Prisma, la
  /// migracion no puede aplicarse sobre una tabla que ya tiene filas: Prisma no
  /// sabe con que rellenarlas. Con `gen_random_uuid()` las rellena la base, cada
  /// una con un valor distinto, en la misma sentencia que agrega la columna.
  tokenBaja String @default(dbgenerated("gen_random_uuid()")) @map("token_baja") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario      Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  reservas     Reserva[]
  pagos        Pago[]
  compras      CompraServicio[]
  expedientes  Expediente[]
  graduaciones Graduado[]
  invitaciones Invitacion[]

  @@unique([tipoDocumento, paisDocumento, documento])
  @@index([apellido, nombre])
  @@index([email])
  @@map("clientes")
}

/// Instructor. Puede o no tener usuario de login asociado (un instructor sin
/// acceso al sistema se administra desde el panel sin cuenta en Supabase Auth).
model Instructor {
  id        String  @id @default(uuid()) @db.Uuid
  usuarioId String? @unique @map("usuario_id") @db.Uuid

  nombre       String
  apellido     String
  telefono     String?
  habilitaMoto Boolean @default(false) @map("habilita_moto")
  habilitaAuto Boolean @default(true) @map("habilita_auto")
  activo       Boolean @default(true)
  /// Color hexadecimal para distinguirlo en el calendario del panel.
  colorAgenda  String  @default("#2563eb") @map("color_agenda")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario          Usuario?                  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  disponibilidades DisponibilidadPlantilla[]
  excepciones      ExcepcionDisponibilidad[]
  reservas         Reserva[]
  invitaciones     Invitacion[]

  @@index([activo])
  @@map("instructores")
}

// ---------------------------------------------------------------------------
// Recursos de agenda
// ---------------------------------------------------------------------------

/// Vehiculo de la academia. Es un recurso reservable con calendario propio:
/// una clase ocupa simultaneamente a un instructor Y a un vehiculo.
model Vehiculo {
  id         String         @id @default(uuid()) @db.Uuid
  patente    String         @unique
  tipo       TipoVehiculo
  marca      String?
  modelo     String?
  /// Cilindrada en cc. Determina para que categoria de libreta sirve (G1/G2/G3).
  cilindrada Int?
  anio       Int?
  estado     EstadoVehiculo @default(ACTIVO)
  /// Vencimiento del SOA. La Intendencia lo exige vigente para el examen practico.
  soaVence   DateTime?      @map("soa_vence") @db.Date
  /// Foto del vehiculo. Ruta dentro del bucket de Storage, no una direccion completa.
  fotoRuta   String?        @map("foto_ruta")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reservas Reserva[]

  @@index([tipo, estado])
  @@map("vehiculos")
}

/// Plantilla de disponibilidad recurrente de un instructor.
/// Las horas se guardan como minutos desde medianoche (0-1440) en hora local
/// de America/Montevideo, para que la plantilla no se corra con el horario de verano.
model DisponibilidadPlantilla {
  id           String @id @default(uuid()) @db.Uuid
  instructorId String @map("instructor_id") @db.Uuid

  /// 0 = domingo ... 6 = sabado
  diaSemana    Int @map("dia_semana")
  minutoInicio Int @map("minuto_inicio")
  minutoFin    Int @map("minuto_fin")

  vigenteDesde DateTime? @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, diaSemana])
  @@map("disponibilidad_plantillas")
}

/// Excepcion puntual sobre la plantilla: licencia, feriado, o un turno extra.
model ExcepcionDisponibilidad {
  id           String        @id @default(uuid()) @db.Uuid
  instructorId String        @map("instructor_id") @db.Uuid
  tipo         TipoExcepcion
  inicio       DateTime      @db.Timestamptz(3)
  fin          DateTime      @db.Timestamptz(3)
  motivo       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, inicio])
  @@map("excepciones_disponibilidad")
}

// ---------------------------------------------------------------------------
// Catalogo comercial
// ---------------------------------------------------------------------------

/// Servicio vendible: clase suelta, pack de N clases, curso completo o gestoria.
/// Se guardan dos precios porque es practica habitual del rubro cobrar distinto
/// segun el medio de pago (contado/transferencia vs. tarjeta).
model Servicio {
  id           String        @id @default(uuid()) @db.Uuid
  slug         String        @unique
  nombre       String
  descripcion  String?
  tipo         TipoServicio
  /// Null en servicios que no involucran vehiculo (por ejemplo, gestoria).
  tipoVehiculo TipoVehiculo? @map("tipo_vehiculo")

  /// Cantidad de clases que otorga la compra (1 para clase suelta).
  cantidadClases Int @default(1) @map("cantidad_clases")
  /// Duracion de cada clase en minutos.
  duracionMin    Int @default(45) @map("duracion_min")

  precioContado Decimal @map("precio_contado") @db.Decimal(12, 2)
  precioTarjeta Decimal @map("precio_tarjeta") @db.Decimal(12, 2)

  activo  Boolean @default(true)
  /// Orden de aparicion en la landing y en el panel.
  orden   Int     @default(0)
  /// Se muestra en la landing publica.
  publico Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  compras CompraServicio[]
  pagos   Pago[]

  @@index([activo, publico, orden])
  @@map("servicios")
}

/// Compra de un servicio por un cliente. Para packs funciona como bolsa de
/// clases: `clasesUsadas` se incrementa al completarse cada reserva.
model CompraServicio {
  id         String @id @default(uuid()) @db.Uuid
  clienteId  String @map("cliente_id") @db.Uuid
  servicioId String @map("servicio_id") @db.Uuid

  clasesTotales Int       @map("clases_totales")
  clasesUsadas  Int       @default(0) @map("clases_usadas")
  /// Precio efectivamente acordado, congelado al momento de la compra.
  montoTotal    Decimal   @map("monto_total") @db.Decimal(12, 2)
  vigenteHasta  DateTime? @map("vigente_hasta") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cliente  Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servicio Servicio  @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  reservas Reserva[]
  pagos    Pago[]

  @@index([clienteId])
  @@map("compras_servicio")
}

// ---------------------------------------------------------------------------
// Agenda
// ---------------------------------------------------------------------------

/// Clase agendada. Ocupa a la vez cliente, instructor y vehiculo.
///
/// La proteccion contra doble reserva NO vive en el codigo de la aplicacion:
/// son dos EXCLUDE constraints de Postgres (btree_gist + tstzrange) definidas
/// en la migracion 20260912120000_agenda_exclusion_constraints. Ver docs/01-modelo-datos.md.
model Reserva {
  id           String  @id @default(uuid()) @db.Uuid
  clienteId    String  @map("cliente_id") @db.Uuid
  instructorId String  @map("instructor_id") @db.Uuid
  vehiculoId   String? @map("vehiculo_id") @db.Uuid
  compraId     String? @map("compra_id") @db.Uuid

  tipo   TipoVehiculo
  inicio DateTime      @db.Timestamptz(3)
  fin    DateTime      @db.Timestamptz(3)
  estado EstadoReserva @default(PENDIENTE)

  /// Punto de encuentro acordado con el alumno.
  lugarEncuentro String? @map("lugar_encuentro")
  /// Indicaciones de la academia para esta clase. El alumno LAS VE en su app.
  observaciones  String?

  /// Como fue la clase, escrito por el instructor que la dio.
  ///
  /// NO se le muestra al alumno: son observaciones de desempeno para la academia
  /// y para la proxima clase, no un mensaje para el. Que no le llegue no depende
  /// de que la pantalla lo oculte: la API elige los campos segun el rol de quien
  /// consulta, y este no entra en los que recibe un CLIENTE.
  notaInstructor String? @map("nota_instructor")

  canceladaAt       DateTime? @map("cancelada_at") @db.Timestamptz(3)
  motivoCancelacion String?   @map("motivo_cancelacion")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cliente       Cliente               @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  instructor    Instructor            @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  vehiculo      Vehiculo?             @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  compra        CompraServicio?       @relation(fields: [compraId], references: [id], onDelete: SetNull)
  pagos         Pago[]
  recordatorios RecordatorioEnviado[]

  @@index([inicio, estado])
  @@index([instructorId, inicio])
  @@index([vehiculoId, inicio])
  @@index([clienteId, inicio])
  @@map("reservas")
}

// ---------------------------------------------------------------------------
// Pagos
// ---------------------------------------------------------------------------

/// Pago unificado para los cuatro canales: checkout online, terminal Point,
/// transferencia con comprobante y efectivo.
model Pago {
  id        String  @id @default(uuid()) @db.Uuid
  clienteId String  @map("cliente_id") @db.Uuid
  /// La compra que genero este pago. Se crea AL APROBARLO, no antes: hasta que
  /// alguien mira el comprobante, el alumno no tiene clases acreditadas.
  compraId  String? @map("compra_id") @db.Uuid
  reservaId String? @map("reserva_id") @db.Uuid

  /// Que esta pagando. Se elige del catalogo y de ahi sale el monto.
  ///
  /// Va aparte de `compraId` porque el servicio se elige al MOMENTO DE PAGAR y
  /// la compra recien existe cuando la administracion aprueba. Entre esos dos
  /// momentos, esto es lo unico que dice que compro la persona.
  servicioId String? @map("servicio_id") @db.Uuid

  /// El monto SIEMPRE lo calcula el backend desde el catalogo. Nunca se toma del cliente.
  monto  Decimal    @db.Decimal(12, 2)
  canal  CanalPago
  estado EstadoPago @default(PENDIENTE)

  /// Identificadores de Mercado Pago (pago online o cobro en terminal Point).
  mpPaymentId String? @unique @map("mp_payment_id")
  mpOrderId   String? @unique @map("mp_order_id")
  /// Referencia propia usada para idempotencia y conciliacion (X-Idempotency-Key).
  externalRef String? @unique @map("external_ref")

  /// Ruta del comprobante de transferencia dentro del bucket privado.
  ///
  /// Formato: <usuarioId>/<pagoId>/<archivo>. Nunca es una URL publica: el
  /// bucket es privado y se lee con una direccion firmada de corta duracion.
  ///
  /// La API NO acepta esta ruta del navegador: la compone con el id de la sesion
  /// y el del pago, y del cuerpo del pedido toma solo el nombre del archivo. Asi
  /// nadie puede hacer que apunte al comprobante de otra persona.
  comprobantePath String? @map("comprobante_path")

  /// Lo que se esperaba cobrar, congelado al crear el pago.
  ///
  /// Se guarda aparte de `monto` para que quede el rastro cuando la
  /// administracion corrige el importe al aprobar: sin esto, un pago corregido
  /// es indistinguible de uno que siempre fue por ese monto.
  montoEsperado Decimal? @map("monto_esperado") @db.Decimal(12, 2)

  /// Anotacion de quien registra o revisa el pago. No la ve el alumno.
  nota String?

  /// Verificacion manual del comprobante de transferencia.
  verificadoPor String?   @map("verificado_por") @db.Uuid
  verificadoAt  DateTime? @map("verificado_at") @db.Timestamptz(3)
  motivoRechazo String?   @map("motivo_rechazo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cliente  Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  compra   CompraServicio? @relation(fields: [compraId], references: [id], onDelete: SetNull)
  reserva  Reserva?        @relation(fields: [reservaId], references: [id], onDelete: SetNull)
  servicio Servicio?       @relation(fields: [servicioId], references: [id], onDelete: SetNull)

  @@index([estado, canal])
  @@index([clienteId, createdAt])
  /// El panel lista por fecha y filtra por estado: es la consulta de la pantalla
  /// de pagos y la del tablero.
  @@index([createdAt])
  @@map("pagos")
}

// ---------------------------------------------------------------------------
// Expedientes de libreta (tramite ante la Intendencia de Maldonado)
// ---------------------------------------------------------------------------

model Expediente {
  id        String            @id @default(uuid()) @db.Uuid
  clienteId String            @map("cliente_id") @db.Uuid
  categoria CategoriaLicencia
  estado    EstadoExpediente  @default(INICIADO)

  libreMultas      Boolean   @default(false) @map("libre_multas")
  charlaFecha      DateTime? @map("charla_fecha") @db.Timestamptz(3)
  teoricoFecha     DateTime? @map("teorico_fecha") @db.Timestamptz(3)
  teoricoAprobado  Boolean?  @map("teorico_aprobado")
  practicoFecha    DateTime? @map("practico_fecha") @db.Timestamptz(3)
  practicoAprobado Boolean?  @map("practico_aprobado")
  emitidaFecha     DateTime? @map("emitida_fecha") @db.Date

  observaciones String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cliente    Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  documentos DocumentoExpediente[]

  @@index([estado])
  @@index([clienteId])
  @@map("expedientes")
}

/// Documento adjunto al expediente. El archivo vive en un bucket PRIVADO de
/// Supabase Storage; aca solo se guarda la ruta. La lectura se hace siempre
/// con signed URL de corta duracion generada por el backend.
model DocumentoExpediente {
  id            String        @id @default(uuid()) @db.Uuid
  expedienteId  String        @map("expediente_id") @db.Uuid
  tipo          TipoDocumento
  storagePath   String        @map("storage_path")
  nombreArchivo String        @map("nombre_archivo")
  mimeType      String        @map("mime_type")
  tamanioBytes  Int           @map("tamanio_bytes")

  verificado    Boolean   @default(false)
  verificadoPor String?   @map("verificado_por") @db.Uuid
  verificadoAt  DateTime? @map("verificado_at") @db.Timestamptz(3)
  /// Vencimiento del documento (por ejemplo, carne de salud o SOA).
  venceEl       DateTime? @map("vence_el") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@index([expedienteId, tipo])
  @@map("documentos_expediente")
}

// ---------------------------------------------------------------------------
// Configuracion y auditoria
// ---------------------------------------------------------------------------

/// Configuracion general de la academia. Tabla de una sola fila (id fijo = 1).
model ConfiguracionAcademia {
  id Int @id @default(1)

  nombre    String  @default("Academia de Choferes Gimenoos")
  direccion String  @default("San Carlos, Maldonado, Uruguay")
  telefono  String?
  whatsapp  String?
  email     String?

  /// Datos de contacto que consume la landing. Viven aca y no en el codigo del
  /// sitio para que la academia los cambie sin desplegar. Lo que quede en null
  /// NO se muestra: la landing oculta el dato en vez de inventar uno.
  ciudad       String  @default("San Carlos")
  departamento String  @default("Maldonado")
  /// Horarios de atencion, en texto libre (ej: "Lunes a viernes de 9 a 19").
  horarios     String?
  /// Enlace de Google Maps para el boton "Como llegar".
  mapaUrl      String? @map("mapa_url")

  /// Coordenadas exactas del local, para dibujar el mapa y trazar la ruta.
  /// Van las dos o ninguna: media coordenada no ubica nada. Lo obliga un CHECK.
  /// Mientras esten en null el sitio NO inventa un punto: muestra la
  /// ilustracion de la zona y no ofrece el boton de "llevame hasta alli".
  latitud   Float?
  longitud  Float?
  instagram String?
  facebook  String?

  /// Minutos libres que se reservan entre dos clases consecutivas.
  bufferMinutos          Int @default(15) @map("buffer_minutos")
  /// Horas minimas de antelacion para que el alumno pueda reservar.
  antelacionMinimaHoras  Int @default(12) @map("antelacion_minima_horas")
  /// Horas minimas de antelacion para cancelar sin penalidad.
  cancelacionMinimaHoras Int @default(24) @map("cancelacion_minima_horas")
  /// Dias hacia adelante que el alumno puede ver y reservar.
  ventanaReservaDias     Int @default(30) @map("ventana_reserva_dias")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("configuracion_academia")
}

/// Un navegador que acepto recibir avisos de la academia.
///
/// Una persona puede tener varias: el telefono, la computadora, y otra si
/// reinstalo la app. Cada una es una suscripcion distinta y todas reciben.
///
/// QUE ES `endpoint` Y POR QUE NO SE MUESTRA NUNCA
///
/// Es una direccion del servicio de notificaciones del navegador (Google,
/// Mozilla, Apple) que apunta a ESE navegador. Quien la tenga, junto con las
/// claves VAPID de la academia, puede mandarle notificaciones a esa persona.
/// Es una credencial: no se devuelve en ningun endpoint ni se muestra en el
/// panel. Es unica porque el navegador la reusa si ya estaba suscripto.
model SuscripcionPush {
  id String @id @default(uuid()) @db.Uuid

  /// De quien es el navegador. Se borra con la cuenta.
  usuarioId String @map("usuario_id") @db.Uuid

  endpoint String @unique
  /// Clave publica del navegador, para cifrar el contenido del aviso.
  p256dh   String
  /// Secreto de autenticacion del navegador, tambien para el cifrado.
  auth     String

  /// Para poder decirle a la persona cual de sus dispositivos es cual.
  /// Se guarda recortado: no hace falta la cadena entera.
  dispositivo String? @db.VarChar(120)

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Cuando se le mando algo por ultima vez con exito.
  ultimoEnvioAt DateTime? @map("ultimo_envio_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("suscripciones_push")
}

/// Cuanta antelacion tiene cada recordatorio de clase.
enum TipoRecordatorio {
  /// El dia antes. Sirve para reorganizarse si no va a poder ir.
  VEINTICUATRO_HORAS
  /// Un rato antes, para que no se le pase. Es el que evita el ausente.
  DOS_HORAS
}

/// Por donde salio un recordatorio.
enum CanalRecordatorio {
  /// Aviso a la academia, para que pueda llamar al alumno.
  TELEGRAM
  /// Notificacion en el telefono del alumno, desde su PWA.
  PUSH
  CORREO
}

/// Un recordatorio que YA se mando. Es lo que impide mandarlo dos veces.
///
/// La garantia es la clave unica de la base y no una comprobacion en el codigo:
/// el disparador es externo y puede llamar dos veces (un reintento, dos
/// ejecuciones que se pisan). Con esto, la segunda insercion falla y no hay
/// forma de que al alumno le lleguen dos avisos de la misma clase.
///
/// Se guarda tambien lo que fallo: un recordatorio que no salio y no deja
/// rastro es indistinguible de uno que nunca correspondio mandar.
model RecordatorioEnviado {
  id        String            @id @default(uuid()) @db.Uuid
  reservaId String            @map("reserva_id") @db.Uuid
  tipo      TipoRecordatorio
  canal     CanalRecordatorio

  /// Si llego a destino. Falso deja anotado el intento para no repetirlo en
  /// bucle cada quince minutos.
  entregado Boolean @default(true)
  /// El motivo del fallo, tal como lo explico el canal.
  error     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  /// La regla entera, en una linea: un recordatorio por clase, tipo y canal.
  @@unique([reservaId, tipo, canal])
  @@index([createdAt])
  @@map("recordatorios_enviados")
}

/// A quien y que se le avisa por Telegram. Una sola fila, como la configuracion.
///
/// Vive aparte de `ConfiguracionAcademia` a proposito: esa tabla la lee el
/// endpoint PUBLICO de la landing para armar el sitio. Con el destino de los
/// avisos adentro, cualquier campo nuevo que alguien agregue al select publico
/// se filtraria sin que nadie lo note. Separado, eso no puede pasar.
///
/// El token del bot NO esta aca: es una credencial y vive en la variable de
/// entorno TELEGRAM_BOT_TOKEN, fuera de la base y de sus respaldos.
model AvisosTelegram {
  id Int @id @default(1)

  /// Conversacion destino. Sale del boton "Buscar conversaciones" del panel,
  /// que pregunta a Telegram quien le hablo al bot.
  chatId     String? @map("chat_id")
  /// Como nombrarla en el panel: "Henry Gimeno", "Avisos Academia". Es para que
  /// se pueda verificar de un vistazo que quedo elegida la correcta.
  chatNombre String? @map("chat_nombre")

  /// Cada aviso se prende y se apaga por separado. El que mas ruido puede hacer
  /// es el del clic de WhatsApp, porque depende de cuanta gente visite el sitio.
  avisaReservaNueva   Boolean @default(true) @map("avisa_reserva_nueva")
  avisaClaseCerrada   Boolean @default(true) @map("avisa_clase_cerrada")
  avisaClaseCancelada Boolean @default(true) @map("avisa_clase_cancelada")
  avisaClicWhatsapp   Boolean @default(true) @map("avisa_clic_whatsapp")
  /// Los recordatorios de clase, 24 horas y 2 horas antes.
  avisaRecordatorios  Boolean @default(true) @map("avisa_recordatorios")

  /// Cuando salio bien el ultimo aviso. Sirve para contestar "esto anda?" sin
  /// tener que mandar uno de prueba.
  ultimoEnvioAt DateTime? @map("ultimo_envio_at") @db.Timestamptz(3)
  /// El ultimo fallo y su motivo, tal como lo explico Telegram. Sin esto, un bot
  /// bloqueado o un chat borrado se ven igual que "no paso nada".
  ultimoErrorAt DateTime? @map("ultimo_error_at") @db.Timestamptz(3)
  ultimoError   String?   @map("ultimo_error")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("avisos_telegram")
}

/// Registro de auditoria de acciones sensibles (acceso a documentos, cambios
/// de estado de pagos, alta/baja de usuarios). Requerido por el principio de
/// seguridad y trazabilidad de la Ley 18.331.
model RegistroAuditoria {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  accion    String
  entidad   String
  entidadId String?  @map("entidad_id")
  /// Metadatos del evento. NUNCA debe contener datos sensibles ni secretos.
  detalle   Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidad, entidadId])
  @@index([createdAt])
  @@map("registros_auditoria")
}

/// Contenido editable de cada seccion del sitio publico.
///
/// Una sola forma para todas las secciones —titulo, bajada y una lista de
/// items— en lugar de una tabla por seccion. La alternativa, un modelo por
/// seccion, multiplica migraciones y formularios para guardar siempre lo mismo:
/// un encabezado y una lista.
///
/// Lo que no este cargado aca cae al texto por defecto que vive en el codigo
/// del sitio, asi la landing sigue completa aunque la API no responda.
model SeccionLanding {
  /// Identificador de la seccion: 'hero', 'porQue', 'beneficios', ...
  /// Lo define el sitio; la API solo acepta claves conocidas.
  clave String @id

  /// Si la seccion se muestra en el sitio.
  visible Boolean @default(true)
  /// Orden entre las secciones de contenido. Menor primero.
  orden   Int     @default(0)

  /// Encabezado de la seccion. Null = se usa el texto por defecto del sitio.
  titulo   String?
  bajada   String?
  /// Texto corto sobre el titulo (la insignia del hero, el sobretitulo).
  etiqueta String?
  /// Texto del boton principal de la seccion, cuando la seccion tiene uno.
  accion   String?

  /// Lista de { titulo, detalle }. Cubre tarjetas, pasos, beneficios y
  /// preguntas frecuentes (pregunta -> titulo, respuesta -> detalle).
  items Json @default("[]")

  actualizadoPor String?  @map("actualizado_por") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("secciones_landing")
}

/// Egreso de un alumno: su diploma y, si autorizo, su foto en la galeria publica.
///
/// El diploma existe para reemplazar a la libreta en la foto de egresado. La
/// libreta muestra nombre completo, numero de documento y fecha de nacimiento:
/// publicarla legible es un riesgo real de suplantacion de identidad para el
/// alumno. El diploma lo emite la academia y no lleva ningun dato sensible, asi
/// que la foto se puede publicar sin exponer a nadie.
model Graduado {
  id        String @id @default(uuid()) @db.Uuid
  clienteId String @map("cliente_id") @db.Uuid

  categoria   CategoriaLicencia
  fechaEgreso DateTime          @map("fecha_egreso") @db.Date
  /// Ano de egreso, desnormalizado: la galeria publica filtra y agrupa por ano
  /// en cada pagina, y un indice sobre una columna es mas barato que una
  /// funcion sobre la fecha en cada consulta.
  anio        Int

  /// Codigo corto para verificar el diploma. Permite comprobar que es autentico
  /// sin que el diploma tenga que mostrar ningun dato del alumno.
  codigo String @unique

  // --- Autorizacion para publicar (Ley 18.331) ------------------------------
  /// Fecha de la firma. Sin esto NO se puede publicar: lo impide una constraint
  /// en la base, no solo el codigo.
  autorizacionAt       DateTime? @map("autorizacion_at") @db.Timestamptz(3)
  /// Quien firmo la autorizacion. Si el alumno es menor, su padre, madre o tutor.
  autorizacionFirmante String?   @map("autorizacion_firmante")
  /// true cuando quien firmo es el representante legal de un menor de edad.
  autorizacionEsTutor  Boolean   @default(false) @map("autorizacion_es_tutor")

  /// Foto del egresado con su diploma. Ruta dentro del bucket de Storage.
  fotoRuta String? @map("foto_ruta")

  /// Si aparece en la galeria publica.
  publicado Boolean @default(false)

  notas String?

  creadoPor String?  @map("creado_por") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// La galeria publica pide los publicados de un ano, ordenados por fecha.
  @@index([publicado, anio, fechaEgreso])
  @@index([clienteId])
  @@map("graduados")
}
