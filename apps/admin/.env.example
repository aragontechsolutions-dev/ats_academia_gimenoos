VITE_API_URL="http://localhost:3000/api/v1"
# Supabase -> Project Settings > API
VITE_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# Clave anonima (publishable). Es la UNICA clave de Supabase que puede vivir en un
# frontend: no saltea RLS. NUNCA poner aca la clave service_role.
VITE_SUPABASE_ANON_KEY="<anon_key>"
# Dominio del sitio publico. Se imprime en el pie del diploma.
VITE_SITIO_URL="https://www.academiagimenoos.com.uy"
# Opcionales: a donde mandar a quien entra al panel con una cuenta que no es de
# administracion.
VITE_APP_INSTRUCTOR_URL="http://localhost:5176"
VITE_APP_ALUMNO_URL="http://localhost:5175"
